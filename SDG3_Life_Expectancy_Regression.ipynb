    "sns.heatmap(df.isnull(), cbar=False, cmap='Reds', yticklabels=False)\n",
    "plt.title('Missing Value Heatmap', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()"
